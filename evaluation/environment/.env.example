# 复制为 evaluation/environment/.env 后填写。不要提交真实密钥。
#
# AML 开源赛道模型约束：LLM = gpt-4o-mini，Embedding = text-embedding-v4（reranker 不受限）。
# - gpt-4o-mini：OpenAI https://api.openai.com/v1（模型名 gpt-4o-mini），
#   或 OpenRouter https://openrouter.ai/api/v1（模型名 openai/gpt-4o-mini）
# - text-embedding-v4：DashScope OpenAI 兼容端点，国际站
#   https://dashscope-intl.aliyuncs.com/compatible-mode/v1，国内站
#   https://dashscope.aliyuncs.com/compatible-mode/v1
# 基线（GLM-5.2 / DeepSeek-V3.2 + bge-m3）配置见 tag reranker-fix-baseline。

# LoCoMo：直接模型、embedding、reranker 与存储配置
API_BASE=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
API_KEY=
MODEL_PROVIDER=openai
# gpt-4o-mini 不认 enable_thinking 等字段，必须为 0
DISABLE_THINKING=0
MODEL_TEMPERATURE=0.01
EMBED_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/embeddings
EMBED_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=
EMBED_MODEL_NAME=text-embedding-v4
EMBEDDING_SSL_VERIFY=false
EMBEDDING_MODEL_DIMENTION=1024
EMBED_TIMEOUT=60
EMBED_MAX_RETRIES=3
REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=agent_memory_vectors
MILVUS_COLLECTION_L0=agent_memory_vectors_l0
MILVUS_COLLECTION_L1=agent_memory_vectors_l1
ES_HOSTS=http://127.0.0.1:9200
ES_FULLTEXT_INDEX=agent_memory_fulltext
ES_FULLTEXT_INDEX_L0=agent_memory_fulltext_l0
ES_FULLTEXT_INDEX_L1=agent_memory_fulltext_l1
# Cohere 风格 /rerank 服务；base_url 含 /v1、不含 /rerank（LoCoMo 与 LongMemEval 共用）。
# 本地：jiuwenmemory-retrieval 的 lme_kit/local/embed_serve.py --port 8906（MiniLM，sigmoid 分）。
# 8905 常被 longmem-bench-ii 的旧 embed_serve.py（无 /rerank）占用，故用 8906。
RERANK_BASE_URL=http://127.0.0.1:8906/v1
RERANK_API_KEY=local
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LongMemEval：启动器会在本机拉起三项代理（抽取 / 回答判分 / embedding）
LONGMEMEVAL_CHAT_UPSTREAM_URL=https://api.openai.com/v1
LONGMEMEVAL_CHAT_MODEL=gpt-4o-mini
LONGMEMEVAL_CHAT_API_KEYS=
# gpt-4o-mini 不认 thinking/enable_thinking 字段，必须为 0（GLM 抽取时为 1）
LONGMEMEVAL_EXTRACT_DISABLE_THINKING=0
# embedding 代理原样 POST 到此 URL，须含 /embeddings 后缀
LONGMEMEVAL_EMBED_UPSTREAM_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/embeddings
LONGMEMEVAL_EMBED_MODEL=text-embedding-v4
LONGMEMEVAL_EMBED_API_KEY=
LONGMEMEVAL_EMBED_DIMENSION=1024
LONGMEMEVAL_EMBED_PROXY_PORT=18937
LONGMEMEVAL_EXTRACT_PROXY_PORT=18938
LONGMEMEVAL_QA_PROXY_PORT=18939
LONGMEMEVAL_CHAT_CONCURRENCY=10
LONGMEMEVAL_EMBED_CONCURRENCY=4
LONGMEMEVAL_PROXY_RETRY_ATTEMPTS=4
LONGMEMEVAL_ANSWER_MAX_TOKENS=16384
LONGMEMEVAL_JUDGE_MAX_TOKENS=4096
