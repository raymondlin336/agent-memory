# AML 适配器环境变量。复制为 deploy/aml/.env 后填写；不要提交真实密钥。
# scripts/run-aml.sh 会自动 source deploy/aml/.env。

# --- 适配器本身 ---
# 提交给 AML 的鉴权 Token（AML 以 Token / Bearer / X-Api-Key 之一携带）。必填，未设则拒绝启动。
# Non-loopback binds need 32+ random characters: python -c "import secrets; print(secrets.token_urlsafe(32))"
# On localhost the start script falls back to local-dev-key when this is empty.
AML_ADAPTER_KEY=
# 适配器状态库（幂等账本）。必须在持久盘上；删除它会让 AML 重试的 Add 重复写入。
# Unset: the start scripts use evaluation/outputs/aml_local/aml_adapter_state.db. On a server set an
# absolute path on persistent disk, e.g. /var/lib/aml/aml_adapter_state.db.
# AML_STATE_DB=

# --- 模型（本赛道固定：LLM=gpt-4o-mini，Embedding=text-embedding-v4 1024 维）---
API_BASE=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
API_KEY=
EMBED_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMBED_MODEL_NAME=text-embedding-v4
EMBED_API_KEY=

# --- 精排（不受限；与基准一致：MiniLM Cohere 方言 /rerank 服务，base_url 含 /v1 不含 /rerank）---
RERANK_BASE_URL=http://127.0.0.1:8906/v1
RERANK_API_KEY=local
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# scripts/start-aml-local.ps1 launches scripts/rerank_server.py with the adapter's python by default
# (pip install -e ".[rerank]"). Optional overrides for a different python / server script:
# RERANK_SERVER_PYTHON=
# RERANK_SERVER_SCRIPT=

# --- 存储（真后端，保证 Add 返回即持久化；索引/集合名与基准评测隔离）---
REDIS_URL=redis://127.0.0.1:6379/0
ES_HOSTS=http://127.0.0.1:9200
AML_MILVUS_URI=http://127.0.0.1:19530

# --- 可选调节（括号内为默认值）---
# AML_MAX_ADD_CONCURRENCY=8        同时处理的 Add 数；满了回 429 让 AML 退避重试
# AML_MAX_SEARCH_CONCURRENCY=32    同时处理的 Search 数
# AML_ADD_DEADLINE_S=1500          单次 Add 软截止（秒）；超时回 503，AML 重试后从断点续写
# AML_NO_SOURCE=1                  与基准一致的 retain_source=false 抽取；0 关闭
# AML_DATE_PREFIX=1                检索结果正文加 [YYYY-MM-DD] 前缀；0 关闭
# AML_OPTIONS_IN_QUERY=0           选择题选项是否拼进检索 query；1 开启
# AML_DIALOGUE_TURN_MAX_CHARS=4096 单个写入单元的最大字符数（超出按句回退）

# --- 本地联调（无 Docker）---
# AML_IN_MEMORY=1                  去掉 Redis / ES / Milvus，使用进程内存储；重启即丢数据，仅限本地联调
